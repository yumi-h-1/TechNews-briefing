# Fill these in a local .env or hosting secret settings. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=yumi-it-briefing

# Default transport: Resend HTTPS API, suitable for a cloud worker.
# With Resend's testing sender, the recipient must be the email of your Resend account.
MAIL_TRANSPORT=resend
RESEND_API_KEY=
MAIL_FROM=Yumi IT Briefing <onboarding@resend.dev>
MAIL_TO=yumi.heo.01@gmail.com

# Optional alternative: MAIL_TRANSPORT=smtp (some hosting plans block SMTP ports).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASSWORD is an app password, never your normal Google password.

BRIEFING_TIMEZONE=Europe/London
BRIEFING_HOUR=8
BRIEFING_MINUTE=0
DATA_DIR=./data
