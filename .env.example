# Copy to .env locally, or set Render environment secrets. Never paste keys in chat.
# GitHub Actions (current deployment): .env is not used. Add the values under
# Settings → Secrets and variables → Actions as marked below; the workflow
# (.github/workflows/daily-briefing.yml) sets the remaining ones itself.
# [Actions secret]
OPENAI_API_KEY=
# [Actions variable, optional] defaults to gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
# [Actions variable, optional] defaults to false in the workflow
LANGSMITH_TRACING=true
# [Actions secret] only needed when LANGSMITH_TRACING is true
LANGSMITH_API_KEY=
# [Actions variable, optional] defaults to technews-briefing
LANGSMITH_PROJECT=technews-briefing
# [Actions secret]
RESEND_API_KEY=
# Use a verified sender/domain, or the provider's permitted test sender.
# [Actions secret]
MAIL_FROM=
# [Set by the workflow] var; SQLite is kept between runs in the Actions cache
DATA_DIR=var
# Adjustable initial defaults, not approved volume/budget requirements.
# [Set by the workflow] PREPARATION_MINUTES=60, so generation starts at 07:00 London
PREPARATION_MINUTES=30
# [Not set by the workflow] the default of 3 applies
MAX_PER_COUNTRY=3
